Kotlin
package com.android.sunucole.ui.theme
import androidx.compose.ui.graphics.Color

val SunuBlue = Color(0xFF3B82F6)
val SunuBlueDark = Color(0xFF1E3A8A)
val White15 = Color(0x26FFFFFF)

